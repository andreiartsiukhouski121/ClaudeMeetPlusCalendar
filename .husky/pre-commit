# Ориентация обязательна: план с пустым или отписочным разделом 0 не коммитится.
# Проверка — чистый Node без Playwright и dev-серверов, поэтому укладывается в миллисекунды.
node scripts/check-orientation.mjs

# Lint и формат — по staged-файлам через lint-staged, а не полным `pnpm lint`: полный прогон
# на этом репозитории идёт 49 с, а хук такой длины начинают обходить `--no-verify`.
pnpm lint-staged

# Юниты целиком (42 теста, 5,5 с). Именно целиком, а не выборкой по изменённым файлам: падение
# чаще всего прилетает в модуль, который сам не менялся. Запуск — после lint-staged, чтобы тесты
# видели уже исправленный `--fix`/`--write` текст, то есть ровно то, что уйдёт в коммит.
# E2E здесь нет намеренно: Playwright поднимает два dev-сервера и стоит полторы минуты —
# это работа `pnpm verify` и CI, а не хука на каждый коммит.
#
# Единственный пропуск — коммит, где в индексе только `.md`. Все 11 юнит-спеков лежат в
# `apps/*/src/**` и не читают ни одного markdown-файла, поэтому такой коммит не может изменить
# их результат. Пропуск сделан не ради красоты: процесс реестра предписывает docs-коммит
# (`pnpm ledger:fill`) после каждой фичи, и на нём 5,5 с юнитов не покупают ничего.
# Любой не-`.md` файл в индексе (`package.json`, конфиг, сам этот хук) возвращает прогон.
if git diff --cached --name-only --diff-filter=ACMR | grep -qv '\.md$'; then
  pnpm test
else
  echo "pre-commit: кроме .md, в индексе ничего нет — юниты пропущены (ни один спек не читает markdown)"
fi
