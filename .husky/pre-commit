# Orientation is mandatory: a plan with an empty or brush-off section 0 does not get committed.
# Pure Node, no Playwright and no dev servers, so it finishes in milliseconds.
node scripts/check-orientation.mjs

# Lint and format run over staged files through lint-staged rather than a full `pnpm lint`: the
# full run takes 49 s here, and a hook that long starts getting bypassed with `--no-verify`.
pnpm lint-staged

# The whole unit suite (42 tests, 5.5 s). Whole rather than filtered by changed files: a failure
# usually lands in a module that was not touched. It runs after lint-staged so the tests see the
# text already fixed by `--fix`/`--write` — exactly what will go into the commit.
# E2E is deliberately absent: Playwright starts two dev servers and costs over a minute — that is
# the job of `pnpm verify` and CI, not of a hook on every commit.
#
# The single exception is a commit holding only `.md` files. Every unit spec lives in
# `apps/*/src/**` and reads no markdown, so such a commit cannot change their result. The skip is
# not cosmetic: the ledger process prescribes a docs commit (`pnpm ledger:fill`) after every
# feature, and 5.5 s of units buys nothing there. Any non-`.md` file in the index brings the run
# back.
if git diff --cached --name-only --diff-filter=ACMR | grep -qv '\.md$'; then
  pnpm test
else
  echo "pre-commit: nothing but .md in the index — units skipped (no spec reads markdown)"
fi
