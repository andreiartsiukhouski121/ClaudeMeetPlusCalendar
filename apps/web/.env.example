# Documents the variable contract. Next.js reads .env on its own, but in this project the default
# lives in code (apps/web/src/lib/api-client.ts) and Playwright passes its own address through
# webServer.env — see playwright.config.ts.

# Base address of the Nest API for server-side requests from Next.js (BFF).
# 127.0.0.1 only: on Windows localhost resolves to ::1, where the server does not listen.
API_URL=http://127.0.0.1:3001
