# Файл документирует контракт переменных. Next.js читает .env сам, но в этом проекте
# значение по умолчанию задано в коде (apps/web/src/lib/api-client.ts), а Playwright
# передаёт свой адрес через webServer.env — см. playwright.config.ts.

# Базовый адрес Nest-API для серверных запросов из Next.js (BFF).
# Только 127.0.0.1: на Windows localhost резолвится в ::1, куда сервер не слушает.
API_URL=http://127.0.0.1:3001
