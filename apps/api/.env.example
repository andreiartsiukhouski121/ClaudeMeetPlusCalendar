# Файл документирует контракт переменных. Nest их из .env НЕ читает — dotenv и @nestjs/config
# не подключены осознанно (см. docs/plans/feature-plan-implementation.md, §8 п.4).
# Задавайте окружением процесса, например:
#   $env:JWT_SECRET='local-secret'; pnpm dev:api

# Порт HTTP-сервера Nest.js (Next.js по умолчанию занимает 3000)
PORT=3001

# Секрет для подписи JWT. В коде есть дефолт для dev с предупреждением в лог;
# Playwright передаёт свой через webServer.env.
JWT_SECRET=dev-secret-change-me

# Срок жизни access-токена. Должен совпадать с SESSION_MAX_AGE_SECONDS в apps/web.
JWT_EXPIRES_IN=1h
