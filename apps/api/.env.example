# Documents the variable contract. Nest does NOT read .env — dotenv and @nestjs/config are
# deliberately absent. Set them in the process environment, for example:
#   $env:JWT_SECRET='local-secret'; pnpm dev:api

# Port of the Nest.js HTTP server (Next.js takes 3000 by default)
PORT=3001

# JWT signing secret. The code has a dev default that logs a warning; Playwright passes its own
# through webServer.env.
JWT_SECRET=dev-secret-change-me

# Access token lifetime. Must match SESSION_MAX_AGE_SECONDS in apps/web.
JWT_EXPIRES_IN=1h
