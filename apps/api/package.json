{
  "name": "@purpleschool/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "pnpm prisma:generate && pnpm db:up && nest start --watch",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:e2e": "pnpm prisma:generate && pnpm db:reset && nest start",
    "lint": "pnpm prisma:generate && eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.ts",
    "db:reset": "node scripts/assert-database-url.mjs && pnpm db:up && node scripts/reset-schema.mjs && prisma db push && pnpm db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@purpleschool/eslint-config": "workspace:*",
    "@purpleschool/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "catalog:",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}
