{
  "name": "purpleschool",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: Next.js (web) + Nest.js (api)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @purpleschool/web dev",
    "dev:api": "pnpm --filter @purpleschool/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @purpleschool/web build",
    "build:api": "pnpm --filter @purpleschool/api build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "eslint . && pnpm -r lint",
    "lint:fix": "eslint . --fix && pnpm -r lint:fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:auth-login": "pnpm -r test -t \"AL-UT-\"",
    "test:home-dashboard": "pnpm -r test -t \"HD-UT-\"",
    "test:meetings-detail": "pnpm -r test -t \"MD-UT-\"",
    "audit": "pnpm audit --audit-level high",
    "check:orientation": "node scripts/check-orientation.mjs",
    "change:new": "node scripts/new-change.mjs",
    "adr:new": "node scripts/new-adr.mjs",
    "fact:next": "node scripts/fact-next.mjs",
    "fact:lock": "node scripts/facts-lock.mjs write",
    "fact:check": "node scripts/facts-lock.mjs check",
    "ledger:fill": "node scripts/fill-ledger-hash.mjs",
    "scenarios:index": "node scripts/scenarios-index.mjs write",
    "skills:sync": "node scripts/skills-sync.mjs sync",
    "skills:check": "node scripts/skills-sync.mjs check",
    "verify": "pnpm check:orientation && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @purpleschool/api test:e2e && pnpm format:check && pnpm e2e && pnpm audit --audit-level high",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke",
    "e2e:regression": "playwright test e2e/regression",
    "e2e:auth-login": "playwright test --grep @auth-login",
    "e2e:home-dashboard": "playwright test --grep @home-dashboard",
    "e2e:p0": "playwright test --grep @p0",
    "e2e:a11y": "playwright test --project=web --grep @accessibility",
    "e2e:security": "playwright test --grep @security",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.62.1",
    "@purpleschool/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
